# --- Database (Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/aa_compass"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe Billing ---
# Exactly two recurring monthly prices: Plus $19/month and Pro $99/month.
# Do NOT add annual plans, extra tiers, lifetime deals, or trials at MVP launch.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID of the Plus plan ($19/month recurring)
STRIPE_PRICE_PLUS="price_..."
# Price ID of the Pro plan ($99/month recurring)
STRIPE_PRICE_PRO="price_..."

# --- Pro realtime voice (OpenAI Realtime API) ---
# Only used to mint ephemeral session tokens for verified Pro subscribers.
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"

# --- Transactional email (password resets) via Resend ---
# Optional: without these, password-reset emails are skipped (URL logged
# server-side only) and the UI still responds generically.
RESEND_API_KEY=""
EMAIL_FROM="A&A Compass <no-reply@your-domain.com>"

# --- Seed admin (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-immediately"
